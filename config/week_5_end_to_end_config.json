{
  "label_type": "Heston Monte Carlo synthetic reference price",
  "disclosure": "This target is a simulated reference price, not an actual OTC transaction price.",
  "market_features": [
    "open",
    "high",
    "low",
    "close",
    "volume",
    "vix",
    "treasury_10y",
    "daily_return",
    "log_return",
    "intraday_return",
    "high_low_range",
    "volume_change",
    "volume_ma_20",
    "close_ma_20",
    "close_ma_60",
